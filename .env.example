LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-v4-flash
MULTIMODAL_ENABLED=true
MULTIMODAL_VISION_API_KEY=${LLM_API_KEY}
MULTIMODAL_VISION_BASE_URL=${LLM_BASE_URL}
MULTIMODAL_VISION_MODEL=deepseek-flash
MULTIMODAL_VISION_API_STYLE=chat
# Required only when enabling the legacy social simulation.
# ENABLE_LEGACY_SIMULATION=true
# ZEP_API_KEY=your-zep-key
# Optional Feishu image retrieval:
# FEISHU_TENANT_ACCESS_TOKEN=your-tenant-token

# Mapricot server key. Enable after selecting this provider for coordinate lookup.
# The key stays server-side; never use a VITE_ variable for it.
LOCATION_PROVIDER=mapricot
MAPRICOT_API_KEY=
LOCATION_LOOKUP_ENABLED=false
